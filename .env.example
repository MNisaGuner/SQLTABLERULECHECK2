# ============================================================
# MSSQL Bağlantı Bilgileri
# ============================================================
DB_SERVER=localhost
DB_DATABASE=YourDatabaseName
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_DRIVER=ODBC Driver 17 for SQL Server

# ============================================================
# Model Sağlayıcı: Anthropic Claude API
# ============================================================
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Kullanılacak Claude modeli. Önerilen: claude-opus-5
ANTHROPIC_MODEL=claude-opus-5

# ============================================================
# Model Sağlayıcı: Yerel Model (ileride kullanılacak, iskelet halinde)
# ============================================================
LOCAL_MODEL_ENDPOINT=http://localhost:11434

# ============================================================
# Oturum (session cookie imzalama anahtarı)
# ============================================================
# Rastgele, uzun bir metin olmalı (örn. `python -c "import secrets; print(secrets.token_hex(32))"`).
# Bu değer değişirse mevcut tüm oturumlar geçersiz olur (herkes tekrar giriş yapar).
SESSION_SECRET_KEY=change-this-to-a-random-secret
